SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Run on the production host once per day at 02:17 local time.
# AUDIT_CHAIN_EXPORT_DIR must be an absolute path outside the app checkout,
