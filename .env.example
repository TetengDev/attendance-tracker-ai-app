# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Tooling / build-time (not needed by the app at runtime) ---
GITHUB_TOKEN=
GITHUB_REMOTE_REPOSITORY=https://github.com/TetengDev/attendance-tracker-ai-app.git
LINEAR_API_KEY=

# --- Application (Phase 0 onward) ---
DATABASE_URL=postgresql+asyncpg://attendance:attendance@localhost:5432/attendance
REDIS_URL=redis://localhost:6379/0

# Biometric encryption key (KEK). Generate: openssl rand -base64 32
# Startup MUST fail loudly if this is absent — never default it.
BIOMETRIC_KEK=

# Admin session signing
SECRET_KEY=

# Face engine — paths are config so the model stays swappable (see CLAUDE.md licensing rule)
FACE_MODEL_DIR=./models
FACE_DETECTOR_MODEL=det_10g.onnx
FACE_RECOGNITION_MODEL=w600k_r50.onnx
FACE_LIVENESS_MODELS=2.7_80x80_MiniFASNetV2.onnx,4_0_0_80x80_MiniFASNetV1SE.onnx

# SMTP (Mailpit in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=attendance@example.org

# SMS (optional, pluggable — Twilio first)
SMS_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
